 "note": "Azure Monitor transformations run row-by-row, so multi-row operators (summarize, join, sort, take) are deliberately absent from this profile \u2014 we support several of them anyway. Each entry carries a `probe`: a KQL snippet that must translate AND execute. Support is measured by running the probe, not by matching a function name.",
 "tabular_operators": [
  {
   "name": "extend",
   "probe": "datatable(a:int)[1] | extend b = a + 1"
  },
  {
   "name": "project",
   "probe": "datatable(a:int)[1] | project a"
  },
  {
   "name": "print",
   "probe": "print x = 1"
  },
  {
   "name": "where",
   "probe": "datatable(a:int)[1] | where a > 0"
  },
  {
   "name": "parse",
   "probe": "datatable(s:string)['a=1'] | parse s with 'a=' v:int"
  },
  {
   "name": "project-away",
   "probe": "datatable(a:int,b:int)[1,2] | project-away b"
  },
  {
   "name": "project-rename",
   "probe": "datatable(a:int)[1] | project-rename z = a"
  },
  {
   "name": "datatable",
   "probe": "datatable(a:int)[1]"
  },
  {
   "name": "columnifexists",
   "probe": "datatable(a:int)[1] | project columnifexists('a', 0)",
   "note": "Azure Monitor spells it columnifexists, not column_ifexists"
  }
 ],
